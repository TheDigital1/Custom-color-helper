{
  "name": "custom-color-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paint Color Tuner: tweak a named paint color and find the closest real paints.",
  "scripts": {
    "dev": "vite",
    "build:data": "tsx scripts/build-data.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
